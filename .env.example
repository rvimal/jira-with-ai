APP_ENV=dev
LOG_LEVEL=INFO
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_PROJECT_KEYS=PROJ
JIRA_JQL=project=PROJ AND statusCategory != Done
JIRA_SCORE_FIELD=customfield_12345
LLM_PROVIDER=stub
LLM_MODEL=gpt-oss
MAX_TICKETS_PER_RUN=100
CONCURRENCY=4
REQUEST_TIMEOUT_SECONDS=30
RETRY_ATTEMPTS=2
