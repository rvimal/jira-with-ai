LLM_BASE_URL=https://llm.example.com/v1/generate
LLM_TOKEN=replace-me
LLM_CERT_PATH=/absolute/path/to/ca.pem
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=60
LLM_VERIFY_SSL=true

MCP_BASE_URL=https://mcp.example.com
MCP_TOKEN=replace-me
MCP_TIMEOUT_SECONDS=60
MCP_VERIFY_SSL=true
MCP_TOOL_CALL_PATH=/tools/call
MCP_SEARCH_TICKETS_TOOL=search_tickets
MCP_GET_TICKET_TOOL=get_ticket
MCP_UPDATE_TICKET_TOOL=update_ticket

PROMPT_ROOT_DIR=prompt_assets
INSTRUCTIONS_DIR=prompt_assets/instructions
EXAMPLES_DIR=prompt_assets/examples
LOG_DIR=logs
LOG_LEVEL=INFO
JOB_NAME=jira-with-ai
JIRA_TICKET_SEARCH_QUERY=status = "To Do"
MAX_TICKETS=25