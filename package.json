{
  "name": "jira-with-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Simple human-configured agent platform for Jira via MCP and LLM",
  "bin": {
    "agent": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "agent": "node src/index.js",
    "ui:build": "npm --prefix ui-app run build",
    "ui": "npm run ui:build && node src/ui/server.js",
    "ui:dev": "npm --prefix ui-app run start"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.9.0",
    "express": "^5.2.1"
  }
}
